    "electric_vehicle/SOC": {
      "path": "electric_vehicle/SOC",
      "structuralHash": "13d034430a5111f56cba5fd5f949f82cbea87dbc17332bcfd4cee82bcff9146c",
      "description": "The SOC (State of Charge) subsystem calculates the current State of Charge of a battery based on input current and internal parameters. It uses a discrete-time integrator to update the SoC over time, with a rate transition block to handle sampling rate differences between inputs.\n\nKey components:\n- Battery_current: Inport block receiving the actual battery current (in amperes).\n- Constant: A constant value representing the reference or initial state of charge.\n- Discrete-Time Integrator (SID: 97): Updates the SoC value using the input current and a gain factor to model charge/discharge behavior.\n- Gain (SID: 96) and Gain1 (SID: 99): Scale the current input appropriately for charge/discharge calculations.\n- Rate Transition (SID: 95): Ensures consistent sampling rates between blocks, particularly when the battery current is sampled at a different rate than the SoC update.\n- Subtract (SID: 98): Performs subtraction operations to compute net charge flow or correction terms.\n- SOC%: Outport block that outputs the calculated State of Charge as a percentage value (0-100%).\n\nThe system operates by integrating the current over time, scaled appropriately by gains and corrected through subtract operations. The rate transition ensures numerical stability when different sampling rates are involved. This model is suitable for real-time battery management systems where accurate SoC estimation is critical.",
      "blocks": [
        {
          "name": "Battery_current",
          "type": "Inport",
          "parameters": {
            "Position": "[20, 123, 50, 137]",
            "ZOrder": "26192",
            "IconDisplay": "Port number"
          }
        },
        {
          "name": "Constant",
          "type": "Constant",
          "parameters": {
            "Position": "[340, 20, 370, 50]",
            "ZOrder": "26191"
          }
        },
        {
          "name": "Discrete-Time Integrator",
          "type": "DiscreteIntegrator",
          "parameters": {
            "Ports": "[1, 1]",
            "Position": "[380, 112, 415, 148]",
            "ZOrder": "26188",
            "InitialConditionSetting": "Auto",
            "SampleTime": "-1",
            "ICPrevOutput": "DiscIntNeverNeededParam",
            "ICPrevScaledInput": "DiscIntNeverNeededParam"
          }
        },
        {
          "name": "Gain",
          "type": "Gain",
          "parameters": {
            "Position": "[310, 115, 340, 145]",
            "ZOrder": "26187",
            "Gain": "1/(80*3600)",
            "ParamDataTypeStr": "Inherit: Inherit via internal rule",
            "OutDataTypeStr": "Inherit: Inherit via internal rule",
            "SaturateOnIntegerOverflow": "off"
          }
        },
        {
          "name": "Gain1",
          "type": "Gain",
          "parameters": {
            "Position": "[520, 65, 550, 95]",
            "ZOrder": "26190",
            "Gain": "100",
            "ParamDataTypeStr": "Inherit: Inherit via internal rule",
            "OutDataTypeStr": "Inherit: Inherit via internal rule",
            "SaturateOnIntegerOverflow": "off"
          }
        },
        {
          "name": "Rate Transition",
          "type": "RateTransition",
          "parameters": {
            "Position": "[210, 109, 250, 151]",
            "ZOrder": "26186"
          }
        },
        {
          "name": "Subtract",
          "type": "Sum",
          "parameters": {
            "Ports": "[2, 1]",
            "Position": "[450, 62, 480, 93]",
            "ZOrder": "26189",
            "Inputs": "+-",
            "InputSameDT": "off",
            "OutDataTypeStr": "Inherit: Inherit via internal rule",
            "SaturateOnIntegerOverflow": "off"
          }
        },
        {
          "name": "SOC%",
          "type": "Outport",
          "parameters": {
            "Position": "[640, 73, 670, 87]",
            "ZOrder": "26193",
            "IconDisplay": "Port number"
          }
        }
      ],
      "outputs": [
